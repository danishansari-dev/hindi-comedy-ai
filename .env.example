# ── Reddit API (PRAW) ──
# Create an app at https://www.reddit.com/prefs/apps/
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=hindi-comedy-ai-scraper/1.0 (by u/YOUR_USERNAME)

# ── YouTube (optional — transcript-api doesn't require auth) ──
# Only needed if you hit rate limits and want to use yt-dlp fallback
# YOUTUBE_API_KEY=your_api_key_here

# ── LLM Providers (Phase 1+) ──
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
